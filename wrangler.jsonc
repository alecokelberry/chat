// The Worker: TanStack Start and the chat agents (src/server.ts), on a free
// workers.dev address.
// Its types (worker-configuration.d.ts) regenerate on install; after editing, run `pnpm wrangler types`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Logs and traces (time in D1 and NVIDIA per request): the Worker's
  // Observability tab. Free keeps them 7 days (from Dec 1, 2026) within
  // 0.5 GB a day shared by logs, traces and Issues; past that, Cloudflare
  // stops recording until 00:00 UTC.
  // Issues groups failures (uncaught errors, 5xx, console.error with an
  // Error) on the Worker's Issues page; free in its beta. It stays here
  // because a Wrangler deploy without it turns Issues off.
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
    "issues": { "enabled": true },
  },
  "upload_source_maps": true,
  // Live at chat.alecokelberry.workers.dev; each branch's Preview at
  // <branch>-chat.alecokelberry.workers.dev (Workers Builds, `previews` below).
  "workers_dev": true,
  "preview_urls": true,
  // Wrangler secrets live; locally `.dev.vars` (README.md), and
  // in e2e the environment (CLOUDFLARE_INCLUDE_PROCESS_ENV).
  // NVIDIA's key, and the AI Gateway's base URL and token (src/lib/ai);
  // Keenable's key for web search (src/lib/ai/search.ts).
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "SETUP_CODE",
      "NVIDIA_API_KEY",
      "AI_GATEWAY_URL",
      "AI_GATEWAY_TOKEN",
      "KEENABLE_API_KEY",
    ],
  },
  // DEV_SIGN_IN is "1" only in .dev.vars and e2e: the local Dev sign-in.
  // MOCK_MODEL likewise: the mock model in place of NVIDIA (src/lib/ai).
  // PASSKEY_RP_ID is the site passkeys belong to: live's own address, so
  // a Preview (never under it) can't ask for live's passkey, and the phone
  // offers only live's here; locally "localhost" (src/lib/auth/server.ts).
  "vars": {
    "DEV_SIGN_IN": "0",
    "MOCK_MODEL": "0",
    "PASSKEY_RP_ID": "chat.alecokelberry.workers.dev",
  },
  // One Durable Object per chat, its messages in its own SQLite
  // (src/lib/chat).
  "durable_objects": {
    "bindings": [{ "name": "ChatAgent", "class_name": "ChatAgent" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }],
  // Users, sign-ins and passkeys (migrations/, applied by `pnpm run deploy`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chat",
      "database_id": "d96596ed-4c29-49fa-9304-915427526af7",
    },
  ],
  // A Preview is a branch's own copy of the Worker: nothing above carries
  // over, so it lists its own vars and bindings. It runs on chat-preview,
  // never the live database, and has its own secrets (README.md). Its
  // passkeys belong to the account's workers.dev domain, the one site every
  // Preview's address sits under, and only chat-preview knows them.
  "previews": {
    "vars": {
      "DEV_SIGN_IN": "0",
      "MOCK_MODEL": "0",
      "PASSKEY_RP_ID": "alecokelberry.workers.dev",
    },
    "durable_objects": {
      "bindings": [{ "name": "ChatAgent", "class_name": "ChatAgent" }],
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "chat-preview",
        "database_id": "1e70df4a-c2db-46d0-8279-e47434393d8a",
      },
    ],
  },
}
