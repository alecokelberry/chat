 import { setStyle } from "../platform/style.js";
 var openHold = 1e3;
+// Patched in Chat (patches/@ui-sdk__core.patch), for ui-sdk issue #1085: an
+// open's start time is held openHold ahead, then set to its first frame's
+// time. WebKit keeps the first start time for what it draws, so on an iPhone
+// the sheet shows nothing for about a second, then jumps open. A held start
+// is left for the browser to pick (the next frame); afterFirstFrame still
+// sets the frame's own time.
+function setStartTime(animation, time) {
+  if (time <= performance.now()) {
+    animation.startTime = time;
+  }
+}
 function afterFirstFrame(view, start) {
   view.requestAnimationFrame(() => view.requestAnimationFrame(start));
 }
