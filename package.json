{
  "name": "chat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite dev --port ${PORT:-3200}",
    "build": "vite build",
    "preview": "vite build && vite preview --port ${PORT:-3300}",
    "deploy": "vite build && wrangler d1 migrations apply chat --remote && wrangler deploy",
    "deploy:preview": "vite build && wrangler d1 migrations apply chat-preview --remote -c wrangler.preview-migrations.jsonc && wrangler preview",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "e2e": "vite build --mode test && playwright test",
    "smoke": "vite build --mode test && NVIDIA_SMOKE=1 playwright test",
    "check": "oxfmt --check && oxlint && tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm check && knip && pnpm test && pnpm e2e && node scripts/worker-size.mjs",
    "skills:update": "npx skills update -p -y && perl -ni -e 'print unless /^disable-model-invocation: true$/' .claude/skills/implement/SKILL.md .claude/skills/to-spec/SKILL.md .claude/skills/to-tickets/SKILL.md .claude/skills/retro/SKILL.md .claude/skills/wayfinder/SKILL.md",
    "postinstall": "wrangler types --strict-vars=false && ln -sfn ../../node_modules/@ui-sdk/core/skills/ui-sdk .claude/skills/ui-sdk"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.93",
    "@ai-sdk/react": "^4.0.181",
    "@better-auth/passkey": "^1.7.25",
    "@cloudflare/ai-chat": "^0.12.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@streamdown/code": "^2.0.1",
    "@streamdown/math": "^1.0.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@ui-sdk/core": "0.1.0-beta.19",
    "@ui-sdk/react": "0.1.0-beta.19",
    "agents": "^0.33.0",
    "ai": "^7.0.177",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "katex": "~0.16.47",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "4.6.0",
    "streamdown": "^2.8.0",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.70.0",
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "^1.65.1",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.45.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  }
}
