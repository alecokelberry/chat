{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "src/styles/app.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    "dist/",
    ".wrangler/",
    "node_modules/",
    "pnpm-lock.yaml",
    "src/routeTree.gen.ts",
    "worker-configuration.d.ts",
    ".claude/skills/",
    "skills-lock.json"
  ]
}
