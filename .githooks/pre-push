#!/usr/bin/env bash
# Pre-push gate. Rewriting your own branch (rebase, fixups,
# --force-with-lease) is fine; rewriting main never is, so a push that
# would move main anywhere but forward is refused. Then `pnpm check` on
# exactly what's committed; the full verify runs in CI.
# `pnpm install` enables it (the prepare script).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
while read -r _ local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  if [ "$local_sha" = "$zero" ]; then
    echo "pre-push: refusing to delete main." >&2; exit 1
  fi
  if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "pre-push: refusing to rewrite main (not a fast-forward)." >&2; exit 1
  fi
done
if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: working tree is dirty; commit or stash so check tests what you push." >&2
  exit 1
fi
pnpm check
